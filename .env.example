# DocLabPharm website and dashboards. Copy to .env.local (or set on the server).
# NEXT_PUBLIC_* values are built into the browser code: set them before `yarn build`.

# Public address of this website (used for links, sitemap and sharing previews)
NEXT_PUBLIC_SITE_URL=https://doclabpharm.com

# DocLabPharm API used by the browser
NEXT_PUBLIC_API_URL=https://api.doclabpharm.com
# Optional: API address the website server uses for public pages (e.g. an internal URL)
API_URL=

# Video calls
NEXT_PUBLIC_AGORA_APP_ID=

# Image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESETS=

# Push notifications (Firebase web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Support chat widget: the full Tawk.to embed script URL (optional)
NEXT_PUBLIC_TAWK_TO_PROPERTY_ID=

# Google Maps JavaScript API key, restricted to this domain (maps arrive in Phase 3)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
